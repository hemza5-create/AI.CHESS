# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_EXTERNAL_SERVER_URL: Optional external server base URL (e.g. https://your-server.example.com)
# Used by offline-capable PWA/Android builds to auto-connect when network is available.
VITE_EXTERNAL_SERVER_URL=""

# KEY_ADMIN_PASSCODE: Passcode required to trigger manual key rotation or change rotation policy.
# If left empty, the UI provides a one-time first-run admin setup form.
KEY_ADMIN_PASSCODE=

# EXTERNAL_SERVER_ID / VITE_EXTERNAL_SERVER_ID: Instance/node identifier sent in X-ChessVision-Server-Id
# Both must match exactly when overridden. Default: cvsu-uci-core-v2
EXTERNAL_SERVER_ID=cvsu-uci-core-v2
VITE_EXTERNAL_SERVER_ID=cvsu-uci-core-v2

# SERVER_API_KEY: Optional server-to-server Bearer / X-API-Key secret for automated callers
SERVER_API_KEY=

# Configurable Backend & Client API Route Paths (must match between API_ROUTE_* and VITE_API_ROUTE_*)
API_ROUTE_BOARD_SCAN=/api/v2/vision/scan-board
API_ROUTE_EXPLAIN=/api/v2/coach/explain
API_ROUTE_TTS=/api/v2/coach/synthesize
API_ROUTE_OWNERSHIP=/api/v2/vault/ownership
API_ROUTE_ENGINE_HEALTH=/api/v2/engine/health
API_ROUTE_ENGINE_VERSION=/api/v2/engine/version
API_ROUTE_ENGINE_AUTO_UPDATE=/api/v2/engine/auto-update
VITE_API_ROUTE_BOARD_SCAN=/api/v2/vision/scan-board
VITE_API_ROUTE_EXPLAIN=/api/v2/coach/explain
VITE_API_ROUTE_TTS=/api/v2/coach/synthesize
VITE_API_ROUTE_OWNERSHIP=/api/v2/vault/ownership
VITE_API_ROUTE_ENGINE_HEALTH=/api/v2/engine/health
VITE_API_ROUTE_ENGINE_VERSION=/api/v2/engine/version
VITE_API_ROUTE_ENGINE_AUTO_UPDATE=/api/v2/engine/auto-update

# Multi-Cloud Infrastructure Nodes (Google Cloud & Amazon AWS) - Public HTTPS Base URLs only
GCP_CLOUD_ENDPOINT_URL=
GCP_CLOUD_REGION=europe-west2
AWS_CLOUD_ENDPOINT_URL=
AWS_CLOUD_REGION=eu-west-1
VITE_GCP_CLOUD_URL=
VITE_GCP_CLOUD_REGION=europe-west2
VITE_AWS_CLOUD_URL=
VITE_AWS_CLOUD_REGION=eu-west-1

